#TOPIC 1: DICTIONARIES

#jaise english dictionary me ek word and uski meaning hoti hai, waise hi python me bhi key and uski value hoti hai within a dcitionary, if agr kuch search krna hai to hum key search krte hai and uski value khud se nikal aati hai.. jaise:
#structure of dictionary:

# dictionary={
#     "key" : "value",
#     "key2" : "value2"
# }

#to print a value:

#print(dictionary["value"])


info={
    "key": "value",  # key generally strings ko banante haim, but float ya int value ko bhi bana skte hai, tuple ko bhi (as wo bhi immutable hota hai)... and obv, VALUE me kuch bhi daal skte hai almost, including list and tuple
    "name": "qaem",
    "age": 22,
    "marks": 97.5,
    "married": False,    #as we can see har data type allowed hai
    "subjects": ["python", "DSA" , "data analytics"],   #ek LIST store kara di , in dictionary - WHICH IS ANOTHER WAY OF STRING MORE THAN ONE VALUE FOR A GIVEN KEY, we can also store mutiple values using tuple
    "topics": ("dict" , "set")  #ek TUPLE store kara dia in dictionary for multiple values for a key
}
print(info)
print(type(info))  #'dict' type

print(info["name"])  #ek particular key se value nikalwa rhe.. if the key doesn't exist, to error ajayega


info["name"] = "zama"  # name" wali key ki value replaced [overwrite hogyi]

info["surname"] = "rizvi"  #ek new key hi create krdi with a value 

print(info["surname"])

#PROPERTIES OF DICTIONARIES:

#(1) - they are unordered... mtlb indexing nhi hoti hai as such
#(2) - mutable.. they can be changed
#(3) - can't create duplicate keys.. mtlb same naam ki 2 keys aren't allowed

null_dict = {}  #empty dictionary

print(null_dict)

#NESTED DICTIONARIES: kisi key ki value ko apne aap me khud ek dictionary bana skte hai'n...

student ={
    "name": "qaem",
    "subjects": {
        "AI": 9,
        "DBMS": 10,
        "CRYPTO":9
    }

}

print(student)
print(student["subjects"])  #andar wali dictionary print hogi

print(student["subjects"] ["AI"])   #ye us subjects wali dictionary ke andar se AI ki value output dega

#DICTIONARY METHODS:

#(1) - to get all keys:

print(student.keys())  #returns the primary keys.. andar ki dict wali nhi
#iska type hoga 'dict_keys'
#we can also Typecast it into a list:

print(list(student.keys()))  # and then we can count the number of keys:
print(len(list(student.keys())))  #prints the length of list = no. of keys in the dictionary

#(2) - to get all the values:

print(student.values()) #obv, isko bhi list me convert kr skte hai using same approach...

#(3)  - to get all (key, value)  pairs as tuples...

print(student.items())
print(len(list(student.items()))) # whi jo upr kia tha...


#we can individually access one of these tuples too.. pehle sare tuples ko ek list me store krlo and then INDEXING use krke access krlo..:

pairs= list(student.items())   #list bana k store krwa diya

print(pairs[0])  #ab 0th index.. yani dictionary ka 1st tuple print krwaya - "name" : "qaem"  print hoga sirf



#(4)  - to get a partiular value by using it's key:

print(student.get("name"))   # "qaem" return hoga

print(student["name"])  #YE WO OLD WAY JO UPR SEEKHA THA.. isme bhi same "qaem" return hoga...


#THEN WHAT'S THE DIFFERENCE?.. see:

#print(student["name2"] )   # -> ERROR degi...

print(student.get("name2"))  # -> NONE" return kregi... no error


#(5) - UPDATE: dictionary me new value pair daalne ko.. even ek dusri dictionary bhi daal skte:

student.update({"gender" : "male"})   # tuples in curly braces obv

print(student) # ab ye newly added tuple bhi dikhaega...

#we can also add a whole new dictionary as a new tuple value:

new_dict={ "handsome": "yes" , "intelligent" :"absolutely"}

student.update(new_dict)  #dhyan rhe.. agr ye new_dict me koi Key Value aesi hui jo already original dictionary ki key hai, to value overwrite hojaegi

print(student)

