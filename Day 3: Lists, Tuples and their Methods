# LIST METHODS:

num=[23, 34, 22, 56 ,37]

#(1) APPEND- adding one element at the last of list
num.append(78) #adds 78 
num.append(12)
print(num)

#(2) SORT - sorts in acsending order
num.sort()
print(num)

#(3) sort(reverse=True) - sorts in descending order
num.sort(reverse=True)
print(num)

#ye sorting strings wali lisyt me bhi hoti hai based on alphabets 
fruits=["banana", "apple", "avocardo" , "guava"]
fruits.sort()
print(fruits)


#(4) REVERSE- reverses the list 
num.reverse()
print(num)

#(5) INSERT - inserts at a particular index
num.insert(1,5) #mtlb INDEX 1 pr VALUE hojaegi 5.. and INDEX 1 pe jo tha wo ab shift hojaega to index 2
print(num)

#(6) REMOVE- removes the first occurence of an element

num2=[23, 2, 3, 23, 45, 3]  


num2.remove(23) #mtlb ye pehla wala 23
num2.remove(3) #and ye pehla wala 3 hata dega...

print(num2) # will give 2, 23, 45, 3

#(7) POP - removes at a certain index...
num2.pop(3) #pops element at index 3 - here pops (3)

print(num2)

