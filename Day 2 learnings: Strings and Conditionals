#INDEXING: helps to access characters, but we can't modify it after fetching

STR="qaem_rizvi"

print(STR[1]) # will print 'a'.. as indexing starts from 0th place..

#SLICING: accesing some parts of string..

print(str[0:3]) #str' wali string me se 0,1,2th place fetch krke de dega.. (starting index included, but not the ending index)

print(str[4:len(str)]) #len(str) mtlb LAST INDEX bhi include krliya using logic... if ending index nhi doge to automatic LAST INDEX le lega, and starting index nhi doge to 0th place se..

#we can also use negative indexing.... starts with -1 and keep on decreasing from right to left...(ulta)

print(str[-3:-1])  #should give ".." only as string me whi hai


#STRING FUNCTIONS:

STRING="i am a coder"

#1:ENDS WITH
print(STRING.endswith("er"))#checks if string is ending with given substring

#2: CAPITALISE
STRING.capitalize() #pehle letter ko capital kardo.. ye ek new string bana deta hai CAPITAL first letter ke sath, original stringme changes nhi hote hai...if we want changes in original string... then is value ka output orginal string me assign krdo..like:

STRING = STRING.capitalize() #ab original string me changes aaye
